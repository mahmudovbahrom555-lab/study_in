# Server
SERVER_PORT=8080
SERVER_ENV=development
SERVER_VERSION=0.1.0
# CORS: comma-separated origins. Default * (dev only). In production set explicitly:
# SERVER_ALLOWED_ORIGINS=https://repetapp.uz,https://app.repetapp.uz
SERVER_ALLOWED_ORIGINS=*

# Database
DATABASE_URL=postgres://repetapp:repetapp_dev_password@localhost:5432/repetapp?sslmode=disable
DATABASE_MAX_CONNS=25

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change_me_in_production_to_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_to_another_random_string_min_32
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# S3 / MinIO
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_BUCKET=repetapp-files
S3_USE_SSL=false
S3_REGION=us-east-1

# SMS (Eskiz.uz)
SMS_PROVIDER=mock
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_ESKIZ_FROM=4546

# Firebase Cloud Messaging
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# Sentry
SENTRY_DSN=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Auto-migrate: set true to run migrations on startup (useful in Docker)
AUTO_MIGRATE=false
