# Скопировать в .env.prod на сервере, заполнить и держать вне git (уже в .gitignore).
# Использование: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Домены (A-записи в Cloudflare DNS должны уже указывать на IP этого сервера)
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=yourdomain.com

# Postgres
POSTGRES_USER=repetapp
POSTGRES_PASSWORD=change_me_strong_random
POSTGRES_DB=repetapp

# Redis
REDIS_PASSWORD=change_me_strong_random

# MinIO (S3-совместимое хранилище файлов)
MINIO_ROOT_USER=repetapp_minio
MINIO_ROOT_PASSWORD=change_me_strong_random
S3_BUCKET=repetapp-files

# JWT — сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_in_production_to_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_to_another_random_string_min_32

# CORS — поставить реальные домены веб-приложения, не "*"
SERVER_ALLOWED_ORIGINS=https://yourdomain.com

# SMS — mock пока нет контракта с Eskiz.uz
SMS_PROVIDER=mock

API_PORT=8080
LOG_LEVEL=info
