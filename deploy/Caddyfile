{$API_DOMAIN} {
	reverse_proxy api:8080
}

{$WEB_DOMAIN} {
	encode gzip

	# Тестовые сборки APK: кладутся на сервер в ./downloads, вне web-сборки.
	# Политика конфиденциальности — статическая страница вне Flutter-приложения.
	handle /privacy {
		rewrite * /privacy.html
		root * /srv/site
		file_server
	}

	handle /downloads/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
