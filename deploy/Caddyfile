{$API_DOMAIN} {
	# Файлы по подписанным ссылкам (S3_PUBLIC_ENDPOINT = API-домен). Корзина
	# приватная: без действующей подписи хранилище отказывает.
	handle /{$S3_BUCKET}/* {
		reverse_proxy seaweedfs:9000
	}

	handle {
		reverse_proxy api:8080
	}
}

{$WEB_DOMAIN} {
	encode gzip

	# Тестовые сборки APK: кладутся на сервер в ./downloads, вне web-сборки.
	# Политика и удаление аккаунта — статические страницы вне Flutter-приложения
	# (ссылки на них требует Google Play).
	@site path /privacy /delete-account
	handle @site {
		rewrite * {path}.html
		root * /srv/site
		file_server
	}

	handle /downloads/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
